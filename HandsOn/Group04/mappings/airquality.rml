@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bm: <http://breathemadrid.es/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@base <http://breathemadrid.es/mappings/> .


<#ObservationMap>
    a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "../csv/calair_tiemporeal-updated.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "http://breathemadrid.es/resource/observation/{PUNTO_MUESTREO}/{FECHA}/H{HORA}" ;
        rr:class bm:Observation
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [
            rr:template "Observation {ID_OBSERVACION}" ;
            rr:termType rr:Literal
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bm:dateTime ;
        rr:objectMap [
            rml:reference "FECHA_HORA" ;
            rr:datatype xsd:dateTime
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bm:value ;
        rr:objectMap [
            rml:reference "VALOR_MEDICION" ;
            rr:datatype xsd:float
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bm:isValid ;
        rr:objectMap [
            rml:reference "ES_VALIDA" ;
            rr:datatype xsd:boolean
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bm:observedAt ;
        rr:objectMap [
            rr:template "http://breathemadrid.es/resource/station/{PROVINCIA}{MUNICIPIO}{COD_ESTACION}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bm:observesPollutant ;
        rr:objectMap [
            rr:template "http://breathemadrid.es/resource/pollutant/{MAGNITUD}" ;
            rr:termType rr:IRI
        ]
    ] .


<#PollutantMap>
    a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "../csv/contaminantes.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "http://breathemadrid.es/resource/pollutant/{MAGNITUD}" ;
        rr:class bm:Pollutant
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [
            rml:reference "NOMBRE" ;
            rr:datatype xsd:string
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bm:pollutantCode ;
        rr:objectMap [
            rml:reference "MAGNITUD" ;
            rr:datatype xsd:string
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bm:pollutantName ;
        rr:objectMap [
            rml:reference "FORMULA" ;
            rr:datatype xsd:string
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bm:unit ;
        rr:objectMap [
            rml:reference "UNIDAD" ;
            rr:datatype xsd:string
        ]
    ] .